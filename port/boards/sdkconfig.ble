# Note this requires building with IDF 4.x
CONFIG_BT_ENABLED=y

# Controller Mode (Classic BR/EDR Only)
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=
CONFIG_BTDM_CONTROLLER_MODE_BLE_ONLY=
CONFIG_BTDM_CONTROLLER_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CONTROLLER_MODE_BTDM=

# Host Stack: Bluedroid (Classic BT Only, BLE Disabled)
CONFIG_BLUEDROID_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_CLASSIC_BT_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_GATTC_ENABLE=n

# Memory Optimizations for Classic BT
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BT_ACL_CONNECTIONS=1
CONFIG_BTDM_CTRL_BR_EDR_SCO_MAX_CONN=0

# Disable NimBLE
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_NIMBLE_ENABLED=n


